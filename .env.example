# Add environment variables here as integrations are introduced.

# Server-only; never expose to client code. Required for the open-source
# feed's authenticated GraphQL refresh and `bun run open-source:snapshot`.
# Without it, the site serves its verified contribution snapshot.
# Also raises API limits for `bun run projects:generate`.
# GITHUB_TOKEN=

# Optional. Production origin used for canonical URLs, the sitemap, and share images.
# Defaults to https://aetosdios.xyz.
# NEXT_PUBLIC_SITE_URL=
