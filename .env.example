# Add environment variables here as integrations are introduced.

# Optional. Server-only; never expose to client code. Raises GitHub API rate
# limits for `bun run projects:generate` and the open-source feed. Public
# access works without it.
# GITHUB_TOKEN=

# Optional. Production origin used for canonical URLs, the sitemap, and share images.
# Defaults to https://aetosdios.xyz.
# NEXT_PUBLIC_SITE_URL=
